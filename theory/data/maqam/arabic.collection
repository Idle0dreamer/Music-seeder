# Declarative Arabic maqam package collection.
#
# The family builder is the executable algebra. This file owns package data:
# symbolic ratio targets, branch stations, route provenance, and admission
# status. Adding a family-template package here must not require a new C++
# style implementation.

collection=arabic-maqam.canonical
version=1

